
#POSTGRES_USER=safesplash
#POSTGRES_PASSWORD=cambiar-por-una-contraseña-larga
#POSTGRES_DB=safesplash

# Base externa (Supabase, Neon...): si se define, el backend y las migraciones la usan en vez del contenedor db.
# En Supabase: Connect → Direct → "Session pooler", y agregar ?sslmode=require&uselibpqcompat=true al final.
# La contraseña es la de la BASE (Project Settings → Database), no la de tu cuenta. Sin @ : / # ? %.
 DATABASE_URL=postgresql://postgres.TUREF:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true

# ------------------------------------------------------------------ backend
# Firma las sesiones de la web. Al menos 32 caracteres; en Docker es obligatoria.
JWT_SECRET=cambiar-por-una-clave-de-al-menos-32-caracteres
# Con este token el backend reconoce al servidor de IA. Distinto de JWT_SECRET.
IA_TOKEN=cambiar-por-otra-clave-larga

# Primer administrador: se crea al arrancar si todavía no hay ninguno (cambiarlo después no le cambia la contraseña).
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar-esta-contraseña

# Dónde se procesan las sesiones si en la web (Piscina y cámara → Procesamiento) se deja "Según el archivo .env":
#   servidor  el servidor de IA (ServidorIA/ProcesamientoServidor)
#   celular   el navegador del dispositivo que inicia la sesión (ServidorIA/ProcesamientoCelular)
PROCESAR_EN=servidor


# ------------------------------------------------------------------ cámara
# Dirección RTSP de la cámara real. Vacía = el relé espera que alguien publique (modo demo).
# CAMERA_RTSP_URL=rtsp://usuario:contraseña@192.168.1.50/axis-media/media.amp
CAMERA_RTSP_URL=

# De dónde leen el video el servidor de IA y el streaming del celular (normalmente, el relé). No hace falta cambiarla.
# CAMERA_SOURCE=rtsp://mediamtx:8554/cam

# Modo demo (docker compose --profile demo up -d): video de la carpeta videos/ que hace de cámara.
DEMO_VIDEO=demo.mp4

